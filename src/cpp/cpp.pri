CONFIG += c++1z

QMAKE_CXXFLAGS += -Wall
QMAKE_CXXFLAGS += -Wno-c++98-compat

IMPORT_HEADER = $$PWD/$$PROJECT_NAME_CAMEL"Import.h"

IMPORT_HEADER_DATA = "// ============================================================" \
                     "//  This file is autogenerated by cpp.pri" \
                     "//  DO NOT EDIT THIS FILE MANUALLY." \
                     "//  Any changes will be overwritten during the next qmake run." \
                     "// ============================================================" \
                     " " \
                     "$${LITERAL_HASH}pragma once" \
                     " " \
                     "$${LITERAL_HASH}if defined(_MSC_VER) || defined(WIN64) || defined(_WIN64) || defined(__WIN64__) || defined(WIN32) || defined(_WIN32) || defined(__WIN32__) || defined(__NT__)" \
                     "$${LITERAL_HASH}  define Q_DECL_EXPORT __declspec(dllexport)" \
                     "$${LITERAL_HASH}  define Q_DECL_IMPORT __declspec(dllimport)" \
                     "$${LITERAL_HASH}else" \
                     "$${LITERAL_HASH}  define Q_DECL_EXPORT __attribute__((visibility(\"default\")))" \
                     "$${LITERAL_HASH}  define Q_DECL_IMPORT __attribute__((visibility(\"default\")))" \
                     "$${LITERAL_HASH}endif" \
                     " " \
                     "$${LITERAL_HASH}if defined($${PROJECT_NAME_CAPITAL}_LIBRARY)" \
                     "$${LITERAL_HASH}  define $${PROJECT_NAME_CAPITAL}_EXPORT Q_DECL_EXPORT" \
                     "$${LITERAL_HASH}elif defined($${PROJECT_NAME_CAPITAL}_SOURCE)" \
                     "$${LITERAL_HASH}  define $${PROJECT_NAME_CAPITAL}_EXPORT" \
                     "$${LITERAL_HASH}else" \
                     "$${LITERAL_HASH}  define $${PROJECT_NAME_CAPITAL}_EXPORT Q_DECL_IMPORT" \
                     "$${LITERAL_HASH}endif"

write_file($$IMPORT_HEADER, IMPORT_HEADER_DATA)

message("Generated import header: $$IMPORT_HEADER")

INCLUDEPATH += $$PWD/

equals(TEMPLATE, lib) {
    contains(CONFIG, plugin) {
        SOURCES += $$PWD/plugin.cpp

        HEADERS += $$IMPORT_HEADER
    }
    else {
        SOURCES += $$files($$PWD/*.cpp, true)
        SOURCES -= $$PWD/plugin.cpp
        SOURCES -= $$PWD/Test.cpp
        SOURCES -= $$PWD/main.cpp

        HEADERS += $$files($$PWD/*.h, true)
        HEADERS -= $$PWD/Test.h
    }
}
else {
    SOURCES += $$files($$PWD/*.cpp, true)
    SOURCES -= $$PWD/plugin.cpp

    HEADERS += $$files($$PWD/*.h, true)
}
